{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/beranda", "destination": "/menu.html" },
    { "source": "/kuis", "destination": "/kuis.html" },
    { "source": "/misi", "destination": "/misi.html" },
    { "source": "/final", "destination": "/final.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
