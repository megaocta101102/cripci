# ==============================================================================
# EduTech City - Konfigurasi Lingkungan (.env)
# ==============================================================================
# Masukkan kredensial proyek Supabase Anda dari:
# Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# URL API Supabase (Contoh: https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Public Anon Key Supabase (Aman digunakan pada sisi frontend)
SUPABASE_ANON_KEY="your-anon-key-here"

# Service Role Key Supabase (Hanya untuk server/backend, jangan ekspos ke publik)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Mode Lingkungan (development | production)
APP_ENV="development"

# URL Aplikasi (Otomatis diisi saat hosting di Vercel atau Google Cloud Run)
APP_URL="http://localhost:3000"
